<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      The single changelog: every change file is included here, in the order it must run.
      Each file is one change, named <change>-v<release>.xml; changeset ids match the file names.
      Liquibase records applied changesets in DATABASECHANGELOG (by file path + id + author), so
      each runs once per database. Never edit, rename or move a changeset that has already run:
      add a new file and include it at the end.
    -->

    <!--
      v1.0.0: baseline, the schema as it existed when Liquibase was introduced (until then
      Hibernate's ddl-auto=update created it). One file per table, parents first. Each changeset
      has the precondition "only if this table doesn't exist" with onFail="MARK_RAN", so on an
      existing database it is recorded as applied without running. Names match the ones
      Hibernate generated, so every environment ends up identical.
    -->
    <include file="changes/create-users-v1.0.0.xml" relativeToChangelogFile="true"/>
    <include file="changes/create-trip-v1.0.0.xml" relativeToChangelogFile="true"/>
    <include file="changes/create-trip-types-v1.0.0.xml" relativeToChangelogFile="true"/>
    <include file="changes/create-trip-invites-v1.0.0.xml" relativeToChangelogFile="true"/>
    <include file="changes/create-expense-v1.0.0.xml" relativeToChangelogFile="true"/>
    <include file="changes/create-itinerary-item-v1.0.0.xml" relativeToChangelogFile="true"/>

    <!-- v1.1.0 -->
    <include file="changes/add-trip-currency-v1.1.0.xml" relativeToChangelogFile="true"/>
    <include file="changes/users-email-unique-not-null-v1.1.0.xml" relativeToChangelogFile="true"/>

</databaseChangeLog>
