<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-trip-types-v1.0.0" author="sreelekha">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="trip_types"/>
            </not>
        </preConditions>

        <createTable tableName="trip_types">
            <column name="trip_id" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="trip_type" type="VARCHAR(255)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="trip_types" baseColumnNames="trip_id"
                                 referencedTableName="trip" referencedColumnNames="trip_id"
                                 constraintName="fkdfk51n3wr9tnnoy139ocrrk5x"/>
        <!-- Hibernate's CHECK for the enum column. Open-source Liquibase has no
             addCheckConstraint change type, so plain SQL with an explicit rollback. -->
        <sql>
            ALTER TABLE trip_types ADD CONSTRAINT trip_types_trip_type_check CHECK (trip_type IN ('RELAXING', 'ADVENTURE', 'CULTURE', 'FOOD_AND_DRINK', 'BEACH', 'CITY_BREAK', 'NATURE'));
        </sql>
        <rollback>
            <dropTable tableName="trip_types"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
